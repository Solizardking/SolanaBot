# ChatGPTEE backend (OpenDots). HTTPS only outside development.
EXPO_PUBLIC_SERVER_URL=https://chatgptee.ai
# Optional: EAS project id after `eas init` (not a secret).
EXPO_PUBLIC_EAS_PROJECT_ID=
# Wallet identity shown in the wallet's approval sheet.
EXPO_PUBLIC_WALLET_IDENTITY_NAME=ChatGPTEE
EXPO_PUBLIC_WALLET_IDENTITY_URI=https://chatgptee.ai
EXPO_PUBLIC_WALLET_IDENTITY_ICON=brand/solana-dots-icon.png
# devnet | testnet | localnet | mainnet (mainnet needs an https RPC URL)
EXPO_PUBLIC_SOLANA_CLUSTER=mainnet
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
